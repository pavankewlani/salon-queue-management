# ==============================================================================
# SALON QUEUE MANAGEMENT SYSTEM — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# For Vercel Deployment & Supabase Cloud Integration
# Copy this file to .env and replace the placeholder values.
# ==============================================================================

# Supabase Project URL (Found in Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Public Key (Safe for browser client usage with RLS)
VITE_SUPABASE_ANON_KEY=sb_publishable_your_public_anon_key_here
